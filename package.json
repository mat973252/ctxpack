{
  "name": "ctxpack",
  "version": "0.0.1",
  "description": "Local-first context packing and handoff CLI for coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ctxpack": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
